{
  "name": "mailharbor",
  "version": "0.1.0",
  "description": "MailHarbor · 邮件图稿自动归档（IMAP 收信 / SMTP 回信）",
  "main": "out/main/index.js",
  "author": "MailHarbor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:core": "node --experimental-strip-types scripts/test-core.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test": "npm run test:core && npm run test:backend"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "imapflow": "^2.12.2",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "imap-server": "^0.0.1",
    "smtp-server": "^3.21.7",
    "mailparser": "^3.15.0",
    "hoodiecrow-imap": "^3.3.1"
  }
}
