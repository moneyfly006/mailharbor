{
  "name": "mailharbor",
  "version": "0.1.24",
  "description": "MailHarbor · 邮件图稿自动归档（IMAP 收信 / SMTP 回信）",
  "main": "out/main/index.js",
  "author": "MailHarbor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:core": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --no-warnings scripts/test-core.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test": "pnpm test:core && pnpm test:seed && pnpm test:backend && pnpm test:sqlite",
    "build:win": "electron-vite build && electron-builder --win nsis --x64",
    "build:win:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "test:sqlite": "MH_FORCE_NODE_SQLITE=1 node --experimental-strip-types --import ./scripts/ts-resolve.mjs --no-warnings scripts/test-sqlite-adapter.ts",
    "test:packaged": "node scripts/packaged-e2e.mjs",
    "test:seed": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --no-warnings scripts/test-seed.ts",
    "test:providers": "node scripts/test-providers.mjs",
    "test:spam": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --no-warnings scripts/test-spam-scan.ts"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "imapflow": "^2.12.2",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hoodiecrow-imap": "^3.3.1",
    "imap-server": "^0.0.1",
    "mailparser": "^3.15.0",
    "playwright": "^1.58.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
